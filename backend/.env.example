# Backend Configuration
# =====================

# Server Configuration
SERVER_PORT=8080

# Spring Profile (dev, prod)
SPRING_PROFILES_ACTIVE=prod

# CORS Configuration (comma-separated list of allowed origins)
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com,http://localhost:3000

# Multipart Upload Configuration
MULTIPART_MAX_FILE_SIZE=3000MB
MULTIPART_MAX_REQUEST_SIZE=3000MB

# Logging Configuration
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_BACKEND_YTDOWNLOAD=DEBUG

# Java Options (optional)
# JAVA_OPTS=-Xmx512m -Xms256m
